<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Deliberately NOT sandboxed: CGEventTap and cross-app Accessibility control are not
      available to sandboxed apps. Hardened runtime (enabled at sign time with
      `--options runtime`) is fine and needs no extra entitlements for this app.
    -->
</dict>
</plist>
